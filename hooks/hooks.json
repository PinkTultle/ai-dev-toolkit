{
  "$schema": "https://json.schemastore.org/claude-code-hooks.json",
  "description": "adt — AI Development Toolkit v0.6.0",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "if": "Edit(**/*.md)",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/post-edit-check.sh"],
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
